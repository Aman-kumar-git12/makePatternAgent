# All optional. Copy to .env to change defaults.
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# AGENT_CORS_ORIGINS=https://your-site.example   # extensions and localhost are always allowed
# AGENT_RATE_LIMIT=30                            # requests per minute per client

# Optional fallback keys, used only when a request sends no X-API-Key.
# Normally users paste their own key in the extension or on http://127.0.0.1:8001.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# GITHUB_TOKEN=
# HF_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
